# Copy this file to `.env.local` and fill in your real Supabase project values.
# Never commit `.env.local` or any service-role / secret keys to Git.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Optional: override the default admin password (defaults to 123 / ١٢٣) and session signing secret
ADMIN_PASSWORD=123
ADMIN_SESSION_SECRET=replace-with-a-random-secret-in-production

